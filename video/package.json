{
  "name": "gaveta-video",
  "private": true,
  "description": "Os vídeos da Gaveta: o app de verdade gravado num Mac (gravacao/), montados com Remotion.",
  "scripts": {
    "estudio": "remotion studio src/index.ts",
    "render": "npm run render:reel && npm run render:uso && npm run render:prova && npm run render:vidro",
    "render:reel": "remotion render src/index.ts Reel out/gaveta-reel.mp4 --crf 16 --jpeg-quality 95",
    "render:uso": "remotion render src/index.ts NaPratica out/gaveta-na-pratica.mp4 --crf 16 --jpeg-quality 95",
    "render:prova": "remotion render src/index.ts Prova out/gaveta-proof.mp4 --crf 16 --jpeg-quality 95",
    "render:vidro": "remotion render src/index.ts Vidro out/gaveta-glass.mp4 --crf 16 --jpeg-quality 95"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536"
  }
}
